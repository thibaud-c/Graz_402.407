<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>3 Points in Graz</name>
    <description>Three landmark points in central Graz, Austria</description>

    <!-- Point 1: Grazer Uhrturm (Clock Tower) -->
    <Placemark>
      <name>1. Grazer Uhrturm</name>
      <description>Iconic clock tower atop the Schloßberg</description>
      <Point>
        <!-- longitude,latitude,altitude -->
        <coordinates>15.4377,47.0734,0</coordinates>
      </Point>
    </Placemark>

    <!-- Point 2: Hauptplatz (Main Square) -->
    <Placemark>
      <name>2. Hauptplatz Graz</name>
      <description>The central main square of Graz</description>
      <Point>
        <coordinates>15.4385,47.0707,0</coordinates>
      </Point>
    </Placemark>

    <!-- Point 3: Kunsthaus Graz -->
    <Placemark>
      <name>3. Kunsthaus Graz</name>
      <description>Modern art museum ("The Friendly Alien") across the Mur river</description>
      <Point>
        <coordinates>15.4343,47.0710,0</coordinates>
      </Point>
    </Placemark>

  </Document>
</kml>